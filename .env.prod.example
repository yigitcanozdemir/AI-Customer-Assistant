# ─────────────────────────────────────────────────────────────
# Production environment template
# Copy to `.env.prod` and fill in real values. NEVER commit `.env.prod`.
# Referenced by docker-compose.prod.yml (env_file) and scripts/*.sh.
# ─────────────────────────────────────────────────────────────

# ── LLM provider selection ──────────────────────────────────
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

EMBEDDING_MODEL=text-embedding-3-small

# ── App ─────────────────────────────────────────────────────
APP_NAME=ecommerce-api
ENVIRONMENT=production
DEBUG=False
PORT=8000
FRONTEND_URL=https://e-commerce-assistant.vercel.app

# ── Database (Postgres + pgvector) ──────────────────────────
# Point DATABASE_URL at the compose `db` service (default below) or an external
# Postgres (e.g. a managed Hetzner DB — use its host instead of `db`).
DATABASE_URL=postgresql+asyncpg://myuser:mypassword@db:5432/ecommerce
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=ecommerce

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_TTL_EMBEDDING=3600
REDIS_TTL_SEARCH=300
REDIS_TTL_SESSION=86400

# ── Auth ────────────────────────────────────────────────────
AUTH_SECRET=change-me-to-a-long-random-string

# ── Logging ─────────────────────────────────────────────────
LOG_FORMAT=json
LOG_LEVEL=INFO

# ── Observability ───────────────────────────────────────────
ENABLE_METRICS=True
# OpenObserve OTLP-over-HTTP endpoint (traces + metrics + logs). Point at your
# OpenObserve instance, or a cloud OTLP backend. Leave unset to disable tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5080/api/default
OTEL_EXPORTER_OTLP_PROTOCOL=http
OTEL_SERVICE_NAME=fastapi-service

# Langfuse (LLM traces / evals / prompt versions), self-hosted via the
# observability stack. Create a project in the Langfuse UI, then paste its keys
# here. Leave the keys blank to disable LLM tracing.
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
