# ─────────────────────────────────────────────────────────────
# Production environment template
# Copy to `.env.prod` and fill in real values. NEVER commit `.env.prod`.
# Referenced by docker-compose.prod.yml (env_file) and scripts/*.sh.
# ─────────────────────────────────────────────────────────────

# ── LLM provider selection ──────────────────────────────────
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

EMBEDDING_MODEL=text-embedding-3-small

# ── App ─────────────────────────────────────────────────────
APP_NAME=ecommerce-api
ENVIRONMENT=production
DEBUG=False
PORT=8000
FRONTEND_URL=https://e-commerce-assistant.vercel.app

# ── Database (Postgres + pgvector) ──────────────────────────
# Point DATABASE_URL at the compose `db` service (default below) or an external
# Postgres (e.g. a managed Hetzner DB — use its host instead of `db`).
DATABASE_URL=postgresql+asyncpg://myuser:mypassword@db:5432/ecommerce
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=ecommerce

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_TTL_EMBEDDING=3600
REDIS_TTL_SEARCH=300
REDIS_TTL_SESSION=86400

# ── Auth ────────────────────────────────────────────────────
# Secret used to sign/verify session tokens (WebSocket + REST auth).
AUTH_SECRET=change-me-to-a-long-random-string
# Token enforcement is OPT-IN. Leave false until the frontend calls
# /session/init and sends the token — with it true, every WebSocket is
# rejected (4401) and the chat stops working.
AUTH_ENFORCED=false

# ── Logging ─────────────────────────────────────────────────
LOG_FORMAT=json
LOG_LEVEL=INFO

# ── Observability ───────────────────────────────────────────
ENABLE_METRICS=True
# OpenObserve OTLP-over-HTTP endpoint (traces + metrics + logs).
#
# The value below assumes you start the bundled `openobserve` service:
#   docker compose -f docker-compose.prod.yml --profile obs up -d
# Without that profile the hostname does not resolve, and the exporter retries
# on every span — so COMMENT THIS OUT if you are not running it.
# Leave unset to disable app tracing entirely (Langfuse still traces the LLM).
OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5080/api/default
OTEL_EXPORTER_OTLP_PROTOCOL=http
OTEL_SERVICE_NAME=fastapi-service

# OpenObserve login (required when running the `obs` profile — compose fails
# fast if unset rather than starting with the documented demo password).
ZO_ROOT_USER_EMAIL=you@example.com
ZO_ROOT_USER_PASSWORD=change-me-to-a-long-random-string
# Days of telemetry to keep before OpenObserve deletes it. Its own default is
# 3650 (10 years), which will fill a small VPS disk; minimum accepted value is 3.
ZO_COMPACT_DATA_RETENTION_DAYS=90

# Langfuse (LLM traces / evals / prompt versions), self-hosted via the
# observability stack. Create a project in the Langfuse UI, then paste its keys
# here. Leave the keys blank to disable LLM tracing.
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
