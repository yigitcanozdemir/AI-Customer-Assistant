# ─────────────────────────────────────────────────────────────
# Local development environment (.env)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── LLM provider selection ──────────────────────────────────
# Which chat provider the agent uses. One of: openai | anthropic | gemini
LLM_PROVIDER=openai

# OpenAI (chat via Responses API; also used for embeddings regardless of LLM_PROVIDER)
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4.1-mini

# Anthropic / Claude (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Google Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embeddings are dimension-locked to the DB schema (Vector(1536)); keep OpenAI.
EMBEDDING_MODEL=text-embedding-3-small

# ── App ─────────────────────────────────────────────────────
APP_NAME=ecommerce-api
ENVIRONMENT=development
DEBUG=True
PORT=8000
FRONTEND_URL=http://localhost:3000

# ── Database (Postgres + pgvector) ──────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=ecommerce
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/ecommerce

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_TTL_EMBEDDING=3600
REDIS_TTL_SEARCH=300
REDIS_TTL_SESSION=86400

# ── Auth ────────────────────────────────────────────────────
# Secret used to sign/verify session tokens (WebSocket + REST auth).
AUTH_SECRET=change-me-to-a-long-random-string
# Token enforcement is OPT-IN. Leave false until the frontend calls
# /session/init and sends the token — with it true, every WebSocket is
# rejected (4401) and the chat stops working.
AUTH_ENFORCED=false

# ── Logging ─────────────────────────────────────────────────
LOG_FORMAT=json
LOG_LEVEL=INFO

# ── Observability ───────────────────────────────────────────
ENABLE_METRICS=True
# OpenObserve: single-container traces/metrics/logs backend (OTLP over HTTP).
# Leave unset to disable tracing. Point at a cloud OTLP backend to use one.
OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5080/api/default
OTEL_EXPORTER_OTLP_PROTOCOL=http
OTEL_SERVICE_NAME=fastapi-service

# Langfuse: LLM traces, evals, prompt versions, cost/token tracking.
# Self-hosted via the observability stack. After `./scripts/dev.sh obs`, open
# http://localhost:3030, create a project, and paste its keys here. Leave blank
# to disable LLM tracing.
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
